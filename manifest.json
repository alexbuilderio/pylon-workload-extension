{
  "manifest_version": 3,
  "name": "Pylon Workload Dashboard",
  "version": "1.0.0",
  "description": "Team workload dashboard showing assignee ticket scores in Pylon",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.usepylon.com/*",
    "https://app.usepylon.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.usepylon.com/*"],
      "js": ["content.js"],
      "css": ["dashboard.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
